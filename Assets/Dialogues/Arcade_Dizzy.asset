  m_Name: Arcade_Dizzy
  m_EditorClassIdentifier: 
  _id: AD
  _title: Arcade_Dizzy
  _entries:
  - SpeakerName: 
    dialogueDisplayTime: 3
    BodyText: "The Disintegration technology\u2026"
  - SpeakerName: 
    dialogueDisplayTime: 5
    BodyText: One of the first big advancements humanity has made
  - SpeakerName: 
    dialogueDisplayTime: 2
    BodyText: ...
  - SpeakerName: 
    dialogueDisplayTime: 4
    BodyText: "It\u2019s so sad seeing Dizzy like this\u2026"
  - SpeakerName: 
    dialogueDisplayTime: 3
    BodyText: But I might be able to patch it up.
  - SpeakerName: 
    dialogueDisplayTime: 4
    BodyText: If I just find a battery, a propeller, and a tip of the disintegrator
  - SpeakerName: 
    dialogueDisplayTime: 4
    BodyText: I can use it to break down the shaft and get into the dispose zone.
  - SpeakerName: 
    dialogueDisplayTime: 3
    BodyText: "I might be able to escape from there\u2026"
