  m_Script: {fileID: 11500000, guid: 8b6352533f9eee9429093b4770f5485e, type: 3}
  m_Name: Chef_TalkTask
  m_EditorClassIdentifier: 
  _id: CTT
  _title: Chef_GivesTask
  _entries:
  - SpeakerName: ChefBot
    dialogueDisplayTime: 2
    BodyText: Hey, hey, hey!
  - SpeakerName: ChefBot
    dialogueDisplayTime: 2
    BodyText: "Have you seen my chef\u2019s hat anywhere recently?"
  - SpeakerName: ChefBot
    dialogueDisplayTime: 3
    BodyText: I believe someone might have taken it to one of the storage rooms.
  - SpeakerName: ChefBot
    dialogueDisplayTime: 2
    BodyText: "\u2026"
  - SpeakerName: ChefBot
    dialogueDisplayTime: 3
    BodyText: Here, I powered off the doors of a few of the nearest ones
  - SpeakerName: ChefBot
    dialogueDisplayTime: 2
    BodyText: Would you mind checking it for me?
  - SpeakerName: 
    dialogueDisplayTime: 2
    BodyText: Will do!
